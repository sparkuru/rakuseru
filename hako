#!/usr/bin/env bash
# hako - Run Rakuseru development commands in a node:22-alpine container.
# The host does not need Node/npm. install, lint, typecheck, test, build,
# and the Vite dev server all run through an ephemeral Docker container.
# The repository is mounted at /app, uid/gid are mapped to the host user,
# and HOME is kept at /app/.devhome inside this repo.
#
# Usage:
#   ./hako npm install
#   ./hako npm run typecheck
#   ./hako npm run lint
#   ./hako npm test
#   ./hako npm run build
#   ./hako npm run dev
#   HAKO_CONTAINER_NAME=rakuseru-dev ./hako npm run dev
#   HAKO_CONTAINER_LABEL=rakuseru.service=dev ./hako npm run dev
#
# Ports: Vite dev server 5173 is published to the host.
# Container services must listen on 0.0.0.0. package.json already runs
# Vite with --host 0.0.0.0.
set -Eeuo pipefail

IMAGE="node:22-alpine"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly IMAGE
readonly REPO_ROOT

step_index=0

quote_command() {
	local arg

	for arg in "$@"; do
		printf '%q ' "$arg"
	done
}

log_step() {
	local label=$1
	shift

	step_index=$((step_index + 1))
	printf '#%s [hako %s] %s\n' "$step_index" "$label" "$(quote_command "$@")" >&2
}

run_step() {
	local label=$1
	shift

	log_step "$label" "$@"
	"$@"
}

main() {
	local container_extra_args
	local devhome
	local docker_cmd
	local tty_flags

	devhome="${REPO_ROOT}/.devhome"
	run_step internal mkdir -p "${devhome}"

	tty_flags=()
	[ -t 0 ] && tty_flags+=(-i)
	[ -t 0 ] && [ -t 1 ] && tty_flags+=(-t)

	container_extra_args=()
	if [[ -n "${HAKO_CONTAINER_NAME:-}" ]]; then
		container_extra_args+=(--name "${HAKO_CONTAINER_NAME}")
	fi
	if [[ -n "${HAKO_CONTAINER_LABEL:-}" ]]; then
		container_extra_args+=(--label "${HAKO_CONTAINER_LABEL}")
	fi

	docker_cmd=(
		docker run --rm
		"${tty_flags[@]}"
		"${container_extra_args[@]}"
		--user "$(id -u):$(id -g)"
		-e HOME=/app/.devhome
		-v "${REPO_ROOT}:/app"
		-w /app
		-p 5173:5173
		"${IMAGE}" "$@"
	)

	log_step run "${docker_cmd[@]}"
	exec "${docker_cmd[@]}"
}

main "$@"
