#!/usr/bin/env bash
# hako - Run Rakuseru npm development commands inside node:22.22.0-alpine3.23.
# The repository is mounted at /app with host uid/gid mapping and repo-local HOME.
#
# Usage:
#   ./hako npm install
#   ./hako npm run lint
#   ./hako npm run typecheck
#   ./hako npm test
#   ./hako npm run build
#   WEB_HOST_PORT=5174 ./dev.sh
#
# One-shot commands publish no ports. dev.sh maps only the Vite web service.
# Explicit HAKO_SERVICE=api runs may map Elysia. Services must listen on 0.0.0.0.
# Change only *_HOST_PORT for parallel sessions.
set -Eeuo pipefail

readonly IMAGE="node:22.22.0-alpine3.23"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT

HAKO_BIND_HOST="${HAKO_BIND_HOST:-127.0.0.1}"
WEB_HOST_PORT="${WEB_HOST_PORT:-5173}"
WEB_CONTAINER_PORT="${WEB_CONTAINER_PORT:-5173}"
API_HOST_PORT="${API_HOST_PORT:-3000}"
API_CONTAINER_PORT="${API_CONTAINER_PORT:-3000}"

step_index=0

quote_command() {
  local arg

  for arg in "$@"; do
    printf '%q ' "${arg}"
  done
}

log_step() {
  local label=$1
  shift

  step_index=$((step_index + 1))
  printf '#%s [hako %s] %s\n' "${step_index}" "${label}" "$(quote_command "$@")" >&2
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

run_step() {
  local label=$1
  shift

  log_step "${label}" "$@"
  "$@"
}

main() {
  local devhome
  local -a docker_command port_flags tty_flags

  [[ $# -gt 0 ]] || die 'a container command is required'
  require_command docker

  devhome="${REPO_ROOT}/.devhome"
  run_step internal mkdir -p -- "${devhome}"

  tty_flags=()
  [[ -t 0 ]] && tty_flags+=(-i)
  [[ -t 0 && -t 1 ]] && tty_flags+=(-t)

  port_flags=()
  case "${HAKO_SERVICE:-}" in
    '') ;;
    web)
      port_flags=(-p "${HAKO_BIND_HOST}:${WEB_HOST_PORT}:${WEB_CONTAINER_PORT}")
      ;;
    api)
      port_flags=(-p "${HAKO_BIND_HOST}:${API_HOST_PORT}:${API_CONTAINER_PORT}")
      ;;
    *)
      die "unknown service for port mapping: ${HAKO_SERVICE}"
      ;;
  esac

  docker_command=(
    docker run --rm
    "${tty_flags[@]}"
    --user "$(id -u):$(id -g)"
    -e HOME=/app/.devhome
    -v "${REPO_ROOT}:/app"
    -w /app
    --label "hako.repo=${REPO_ROOT}"
    --label "hako.scope=${HAKO_SCOPE:-manual}"
    --label "hako.service=${HAKO_SERVICE:-}"
    "${port_flags[@]}"
    "${IMAGE}" "$@"
  )

  log_step run "${docker_command[@]}"
  exec "${docker_command[@]}"
}

main "$@"
