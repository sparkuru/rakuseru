# Copy this file to .env, set mode 0600, and replace every blank secret.
# Generate each database password with: openssl rand -hex 32
# Generate CREDENTIAL_ENCRYPTION_KEY with: openssl rand -base64 32

RAKUSERU_IMAGE_TAG=local
RAKUSERU_WEB_BIND_ADDRESS=127.0.0.1
RAKUSERU_WEB_PORT=8080

PUBLIC_ORIGIN=
SESSION_COOKIE_NAME=rakuseru_session
SESSION_TTL_SECONDS=86400

MARIADB_DATABASE=rakuseru
MARIADB_USER=rakuseru
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
DB_CONNECTION_LIMIT=10

CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
